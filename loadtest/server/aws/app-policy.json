{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "Profile",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::hanggeut-a301-loadtest/profile/*"
    },
    {
      "Sid": "RecordingsAndBackup",
      "Effect": "Allow",
      "Action": ["s3:PutObject", "s3:GetObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"],
      "Resource": ["arn:aws:s3:::hanggeut-a301-loadtest/recordings/*", "arn:aws:s3:::hanggeut-a301-loadtest/backup/*"]
    },
    {
      "Sid": "Bucket",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::hanggeut-a301-loadtest"
    }
  ]
}
