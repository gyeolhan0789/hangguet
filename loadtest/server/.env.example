# 부하 테스트 서버 환경 변수. 서버에서 이 파일을 .env로 복사해 채우고 권한을 600으로 둔다(chmod 600 .env).
# 운영 값을 쓰지 않고 새로 만든다. 외부 API 키만 운영과 같은 키를 쓴다(load_test_plan 3.1.3).
# .env는 커밋하지 않는다.

# 운영에 떠 있는 이미지 태그(커밋 짧은 SHA). 실행할 때 IMAGE_TAG=... 로 넘겨도 된다
IMAGE_TAG=

# 새로 만드는 비밀값
# DB 비밀번호: openssl rand -base64 24
DB_PASSWORD=
# JWT 서명 키(32바이트 이상): openssl rand -base64 48
JWT_SECRET=
# 문의 암호화 키(Base64, 32바이트): openssl rand -base64 32
INQUIRY_ENCRYPTION_KEY=
# 관리자 계정(기동 때 만든다)
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=
# LiveKit 키 · 시크릿(아무 이름 · 32자 이상): 예) LIVEKIT_API_KEY=lt-key, LIVEKIT_API_SECRET=$(openssl rand -hex 32)
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
GRAFANA_ADMIN_PASSWORD=

# Cloudflare Tunnel a301-loadtest의 토큰(README.md 3단계)
CLOUDFLARE_TUNNEL_TOKEN=

# 테스트 IAM 사용자 키(README.md 4단계). 녹화(egress)와 앱(app)을 나눈다
LIVEKIT_EGRESS_S3_ACCESS_KEY=
LIVEKIT_EGRESS_S3_SECRET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 테스트 버킷 이름(기본 hanggeut-a301-loadtest)
S3_BUCKET=hanggeut-a301-loadtest

# 외부 API 키(운영과 같은 키)
SONIOX_API_KEY=
LLM_API_KEY=
# 비우면 질문 글로만 진행한다(TTS 없음)
ELEVENLABS_API_KEY=
# 비우면 리액션 없이 진행한다. 자소서 검증도 Jev를 쓰므로 비우면 지원서를 저장할 수 없다
JEV_API_KEY=

# GMS 주소. 비우면 실제 GMS. 부하 회차는 GMS 스텁 주소를 넣는다(load_test_plan 3.4)
LLM_CHAT_URL=

# 에이전트 분리(compose.agent-split.yml)를 쓸 때만: 이 서버의 사설 IP(hostname -I의 첫 값, 예: 172.31.x.x)
MAIN_PRIVATE_IP=

# Redis 비밀번호(필수, 운영 compose가 요구한다)
# 공백 · 따옴표 없이: openssl rand -hex 24. 에이전트 ASG 시험 때는 SSM /a301/loadtest/agent/redis-password에도 같은 값
REDIS_PASSWORD=
# 운영 경로 재현(deploy/prod/compose.asg.yml, loadtest/agent/README.md)을 쓸 때만: 이 서버의 Tailscale IP(deploy/asg/main-tailscale.sh가 출력한다)
MAIN_TAILSCALE_IP=

# 운영 compose가 필수로 받는 설정 해시(라벨 a301.config-hash). 운영은 deploy.sh가 파일 내용으로 계산해 넣고,
# 해시가 바뀐 서비스만 up -d가 다시 만든다. 테스트 서버는 고정값으로 두고, 설정을 고치면 그 서비스를 직접 다시 만든다(README.md 6단계)
A301_NGINX_CONFIG_HASH=loadtest
A301_LIVEKIT_CONFIG_HASH=loadtest
A301_PROMETHEUS_CONFIG_HASH=loadtest
A301_BLACKBOX_CONFIG_HASH=loadtest
A301_LOKI_CONFIG_HASH=loadtest
A301_ALLOY_CONFIG_HASH=loadtest
A301_GRAFANA_CONFIG_HASH=loadtest
