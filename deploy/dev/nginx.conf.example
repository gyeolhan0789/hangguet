# 개발 서버 Nginx 설정 예시 (미니PC, Nginx 컨테이너)
# hangguet.yobistory.com의 server 블록 전체다. deploy/mock/nginx.conf.example로 넣어 둔 server 블록을 이 내용으로 바꾼다.
# 같은 server_name으로 server 블록을 하나 더 만들면 Nginx가 뒤의 것을 무시하므로, 블록은 하나만 둔다.
# 설정을 넣은 뒤: docker exec <nginx 컨테이너> nginx -t && docker exec <nginx 컨테이너> nginx -s reload
#
# 경로
# - /mock/be/ → a301-mock:8080       목 서버 (기존 그대로)
# - /be/      → a301-dev-be:8080     실제 BE. /be를 떼고 넘긴다. Swagger: /be/docs
# - /         → a301-dev-fe:3000     FE
# Nginx는 가장 길게 맞는 접두사를 고르므로 /mock/be/와 /be/가 /보다 먼저 잡힌다.
# AI(a301-dev-ai)는 내부 전용이라 여기에 없다.
#
# TLS는 Cloudflare에서 끝나고, cloudflared → Nginx 구간은 HTTP다.
# 그래서 원래 요청이 https였다고 X-Forwarded-* 헤더로 알려 준다.
# - BE·목 서버: forward-headers-strategy: framework라 이 헤더로 Swagger "Try it out" 주소를 만든다.
# - FE: 서버 액션은 요청의 Origin과 Host(X-Forwarded-Host)가 같은지 확인하므로 Host를 그대로 넘겨야 한다.
server {
    listen 80;
    server_name hangguet.yobistory.com;

    # Nginx가 만드는 리다이렉트(/be → /be/ 등)를 상대 주소로 보낸다.
    # 절대 주소로 보내면 Nginx가 받은 요청 기준인 http://로 나가 Cloudflare 앞의 https가 풀린다.
    absolute_redirect off;

    # 주소를 변수로 두고 Docker 내장 DNS로 찾는다(결과는 10초 캐시 후 다시 조회).
    # proxy_pass에 이름을 바로 쓰면 Nginx가 시작할 때 한 번만 찾아서
    # - 컨테이너가 꺼져 있으면 Nginx가 아예 뜨지 않고(다른 사이트까지 중단)
    # - 재배포로 컨테이너 IP가 바뀌면 reload 전까지 502가 난다
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $mock_upstream http://a301-mock:8080;
    set $be_upstream   http://a301-dev-be:8080;
    set $fe_upstream   http://a301-dev-fe:3000;

    # 세 경로가 같이 쓰는 헤더
    proxy_set_header Host               $host;
    proxy_set_header X-Real-IP          $http_cf_connecting_ip;
    proxy_set_header X-Forwarded-For    $http_cf_connecting_ip;
    proxy_set_header X-Forwarded-Proto  https;
    proxy_set_header X-Forwarded-Host   $host;
    proxy_set_header X-Forwarded-Port   443;

    # 목 서버 (기존 설정과 같다)
    location = /mock/be {
        return 308 /mock/be/;
    }

    location /mock/be/ {
        # 목 서버는 접두사 없이 동작하므로 /mock/be를 떼고 넘긴다.
        # proxy_pass에 변수를 쓰면 접두사가 자동으로 떼어지지 않아 rewrite로 뗀다.
        rewrite ^/mock/be(/.*)$ $1 break;
        proxy_pass $mock_upstream;
        # location 안에서 proxy_set_header를 하나라도 쓰면 위의 공통 헤더가 상속되지 않으므로 모두 다시 적는다.
        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For    $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto  https;
        proxy_set_header X-Forwarded-Host   $host;
        proxy_set_header X-Forwarded-Port   443;
        # Swagger·리다이렉트 주소 앞에 /mock/be를 붙이게 한다
        proxy_set_header X-Forwarded-Prefix /mock/be;
    }

    # 실제 BE
    location = /be {
        return 308 /be/;
    }

    location /be/ {
        rewrite ^/be(/.*)$ $1 break;
        proxy_pass $be_upstream;
        proxy_set_header Host               $host;
        proxy_set_header X-Real-IP          $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For    $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto  https;
        proxy_set_header X-Forwarded-Host   $host;
        proxy_set_header X-Forwarded-Port   443;
        # Swagger·리다이렉트 주소 앞에 /be를 붙이게 한다
        proxy_set_header X-Forwarded-Prefix /be;
    }

    # FE (나머지 모든 경로). 접두사 없이 그대로 넘긴다.
    location / {
        proxy_pass $fe_upstream;
    }
}

# (선택) 이전 주소 hangguet-bemock.yobistory.com → 새 주소로 넘긴다. 308이라 POST도 그대로 유지된다.
# server {
#     listen 80;
#     server_name hangguet-bemock.yobistory.com;
#     return 308 https://hangguet.yobistory.com/mock/be$request_uri;
# }
