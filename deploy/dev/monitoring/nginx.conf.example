# 미니PC의 기존 Nginx conf.d에 별도 파일로 추가한다.
# Cloudflare Tunnel: hanggeut-grafana.yobistory.com -> 기존 Nginx의 HTTP 80 포트.
# Nginx와 Grafana는 server_public-network에 함께 연결되어야 한다.
# 적용 전 docker exec <nginx 컨테이너> nginx -t, 적용 후 nginx -s reload.
server {
    listen 80;
    server_name hanggeut-grafana.yobistory.com;

    # Grafana 재배포로 IP가 바뀌어도 Nginx를 재시작하지 않고 다시 찾는다.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $grafana_upstream http://a301-dev-grafana:3000;

    location / {
        proxy_pass $grafana_upstream;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
    }

    # Grafana Live의 WebSocket 연결.
    location /api/live/ {
        proxy_pass $grafana_upstream;
        proxy_http_version 1.1;
        proxy_set_header Upgrade           $http_upgrade;
        proxy_set_header Connection        "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-For   $http_cf_connecting_ip;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-Host  $host;
        proxy_set_header X-Forwarded-Port  443;
    }
}
