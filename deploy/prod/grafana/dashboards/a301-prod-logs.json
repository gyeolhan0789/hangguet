        "label": "에이전트 인스턴스",
        "type": "query",
        "description": "ASG agent instance (EC2 instance id). All also keeps logs without the label (main server). Picking one shows only that instance",
        "datasource": {
          "type": "loki",
          "uid": "a301-loki"
        },
        "query": {
          "refId": "LokiVariableQueryEditor-VariableQuery",
          "type": 1,
          "label": "instance_id",
          "stream": "{env=\"prod\", service=\"a301-prod-ai-agent\"}"
        },
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": []
      },
      {
        "name": "level",
        "label": "수준",
        "type": "custom",
        "query": "전체 : ^, 오류 : (?i)(error|exception|traceback|fatal|critical), 경고 이상 : (?i)(error|exception|traceback|fatal|critical|warn)",
        "current": {
          "text": "전체",
