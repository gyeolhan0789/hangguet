{
  "uid": "a301-prod-logs",
  "title": "A301 운영 서버 로그",
  "description": "Logs from a301-prod-* containers (Loki, kept 7 days). Top: errors and warnings by flow. Bottom: all logs filtered by service, level and search.",
  "tags": [
    "a301",
    "logs"
  ],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "schemaVersion": 41,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "a301-loki"
        },
        "query": "label_values(service)",
        "definition": "label_values(service)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "level",
        "label": "수준",
        "type": "custom",
        "query": "전체 : ^, 오류 : (?i)(error|exception|traceback|fatal|critical), 경고 이상 : (?i)(error|exception|traceback|fatal|critical|warn)",
        "current": {
          "text": "전체",
          "value": "^"
        },
        "options": [
          {
            "text": "전체",
            "value": "^",
            "selected": true
          },
          {
            "text": "오류",
            "value": "(?i)(error|exception|traceback|fatal|critical)",
            "selected": false
          },
          {
            "text": "경고 이상",
            "value": "(?i)(error|exception|traceback|fatal|critical|warn)",
            "selected": false
          }
        ],
        "includeAll": false,
        "multi": false
      },
      {
        "name": "search",
        "label": "검색어",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "흐름별 오류 · 경고",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "BE 오류 · 경고",
      "description": "Spring ERROR and WARN lines plus exception stacks (at ... / Caused by)",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=\"a301-prod-be\"} |~ `(ERROR|WARN|^\\s+at |Caused by|Exception)`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "logs",
      "title": "면접 진행 (AI 에이전트)",
      "description": "Errors and warnings from joining rooms, speech recognition (Soniox), question audio (ElevenLabs) and reactions (Jev)",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=\"a301-prod-ai-agent\"} |~ `(?i)(error|exception|traceback|fatal|critical|warn)`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3
    },
    {
      "type": "logs",
      "title": "분석 작업 (질문 생성 · 채점 · 녹화 합치기)",
      "description": "Errors and warnings from GMS (LLM) calls, S3 and ffmpeg",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=\"a301-prod-ai-analysis\"} |~ `(?i)(error|exception|traceback|fatal|critical|warn)`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 4
    },
    {
      "type": "logs",
      "title": "미디어 · 녹화 (LiveKit · Egress)",
      "description": "Errors and warnings from room connections and recordings",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=~\"a301-prod-(livekit|egress)\"} |~ `(?i)(error|warn)`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 5
    },
    {
      "type": "logs",
      "title": "Nginx 5xx 응답",
      "description": "5xx responses users actually received, plus Nginx errors (upstream connect failures, etc.)",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=\"a301-prod-nginx\"} |~ `(\" 5[0-9][0-9] |\\[(error|crit|alert|emerg)\\])`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 6
    },
    {
      "type": "logs",
      "title": "기동 · 재시작",
      "description": "When services started. Use it to find deploys, restarts and recoveries after a crash",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\"} |~ `(Started A301Application|Application startup complete|분석 작업자를 시작한다|registered worker|Ready in|starting LiveKit server|service ready|ready for start up|Registered tunnel connection|ready to accept connections|Ready to accept connections)`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 7
    },
    {
      "id": 8,
      "type": "row",
      "title": "전체 로그",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "로그",
      "description": "Filtered by the service, level and search above. Newest first. Click a line to see its container and service labels",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=~\"$service\"} |~ `$level` |= `$search`",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 24,
        "w": 24,
        "x": 0,
        "y": 29
      },
      "id": 9
    }
  ]
}
