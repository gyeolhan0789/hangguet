  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "흐름별 오류 · 경고",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "type": "logs",
      "title": "BE 오류 · 경고",
      "description": "Spring ERROR and WARN lines plus exception stacks (at ... / Caused by)",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=\"a301-prod-be\"} |~ `(ERROR|WARN|^\\s+at |Caused by|Exception)`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "id": 2
    },
    {
      "type": "logs",
      "title": "면접 진행 (AI 에이전트)",
      "description": "Errors and warnings from joining rooms, speech recognition (Soniox), question audio (ElevenLabs) and reactions (Jev)",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=\"a301-prod-ai-agent\", instance_id=~\"$agent_instance\"} |~ `(?i)(error|exception|traceback|fatal|critical|warn)`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "id": 3
    },
    {
      "type": "logs",
      "title": "분석 작업 (질문 생성 · 채점 · 녹화 합치기)",
      "description": "Errors and warnings from the three workers: question generation (ai-plan), scoring and results (ai-analysis), recording merge (ai-recording). Covers GMS (LLM) calls, S3 and ffmpeg",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=~\"a301-prod-ai-(analysis|plan|recording)\"} |~ `(?i)(error|exception|traceback|fatal|critical|warn)`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "id": 4
    },
    {
      "type": "logs",
      "title": "미디어 · 녹화 (LiveKit · Egress)",
      "description": "Errors and warnings from room connections and recordings",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=~\"a301-prod-(livekit|egress)\"} |~ `(?i)(error|warn)`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "id": 5
    },
    {
      "type": "logs",
      "title": "Nginx 5xx 응답",
      "description": "5xx responses users actually received, plus Nginx errors (upstream connect failures, etc.)",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=\"a301-prod-nginx\"} |~ `(\" 5[0-9][0-9] |\\[(error|crit|alert|emerg)\\])`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 19
      },
      "id": 6
    },
    {
      "type": "logs",
      "title": "기동 · 재시작",
      "description": "When services started. Use it to find deploys, restarts and recoveries after a crash",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\"} |~ `(Started A301Application|Application startup complete|분석 작업자를 시작한다|registered worker|Ready in|starting LiveKit server|service ready|ready for start up|Registered tunnel connection|ready to accept connections|Ready to accept connections)`",
          "queryType": "range",
          "maxLines": 500
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 19
      },
      "id": 7
    },
    {
      "id": 250,
      "type": "row",
      "title": "소요 시간 · 사용량 (로그에서 계산)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "id": 251,
      "title": "에이전트 외부 호출 소요 시간 p95",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {env=\"prod\", service=\"a301-prod-ai-agent\", instance_id=~\"$agent_instance\"} |~ `ms=\\d+` | regexp `(?P<call>Jev 인상 판단|Jev 판단|발화 중단 안내 음성 합성|질문 음성 합성|꼬리질문 생성)[^\"]*?ms=(?P<ms>\\d+)` | call != \"\" | unwrap ms | __error__=\"\" [$__interval]) by (call)",
          "legendFormat": "{{call}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "description": "From the agent's ms= log lines: Jev reaction and impression, question and interruption TTS, follow-up question generation",
      "interval": "1m"
    },
    {
      "id": 252,
      "title": "GMS 호출 소요 시간 p95 (서비스별)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {env=\"prod\", service=~\"a301-prod-ai-(agent|plan|analysis|recording)\"} |~ `GMS 호출 (완료|실패) ms=` | regexp `GMS 호출 (?P<status>완료|실패) ms=(?P<ms>\\d+)` | unwrap ms | __error__=\"\" [$__interval]) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "description": "Includes retries. agent = follow-up questions, plan = question generation, analysis = scoring and results",
      "interval": "1m"
    },
    {
      "id": 253,
      "title": "GMS 실패 · 재시도 후 성공 (건수)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "sum by (service) (count_over_time({env=\"prod\", service=~\"a301-prod-ai-(agent|plan|analysis|recording)\"} |~ `GMS 호출 실패 ms=` [$__interval]))",
          "legendFormat": "실패 {{service}}"
        },
        {
          "refId": "B",
          "queryType": "range",
          "expr": "sum by (service) (count_over_time({env=\"prod\", service=~\"a301-prod-ai-(agent|plan|analysis|recording)\"} |~ `GMS 호출 완료 ms=\\d+ attempts=([2-9]|\\d{2,})` [$__interval]))",
          "legendFormat": "재시도 후 성공 {{service}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "bars",
            "fillOpacity": 60,
            "lineWidth": 1,
            "stacking": {
              "mode": "normal"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 37
      },
      "interval": "1m"
    },
    {
      "id": 254,
      "title": "분석 작업 처리 시간 p95 (작업 종류별)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {env=\"prod\", service=~\"a301-prod-ai-(analysis|plan|recording)\"} |~ `작업 끝 jobType=` | regexp `작업 끝 jobType=(?P<jobType>\\S+) jobId=\\S+ result=(?P<result>\\S+) ms=(?P<ms>\\d+)` | unwrap ms | __error__=\"\" [$__interval]) by (jobType)",
          "legendFormat": "{{jobType}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 37
      },
      "description": "From 'job end' lines of the three workers",
      "interval": "1m"
    },
    {
      "id": 255,
      "title": "분석 작업 큐 대기 시간 p95 (작업 종류별)",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "a301-loki"
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "range",
          "expr": "quantile_over_time(0.95, {env=\"prod\", service=~\"a301-prod-ai-(analysis|plan|recording)\"} |~ `작업 시작 jobType=` | regexp `작업 시작 jobType=(?P<jobType>\\S+) .*waitMs=(?P<waitMs>-?\\d+)` | unwrap waitMs | __error__=\"\" [$__interval]) by (jobType)",
          "legendFormat": "{{jobType}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
