{
  "uid": "a301-prod-logs",
  "title": "A301 운영 서버 로그",
  "description": "a301-prod-* 컨테이너 로그(Loki, 7일 보관). 서비스를 고르고 검색어를 넣어 찾는다.",
  "tags": ["a301", "logs"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 0,
  "schemaVersion": 41,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "서비스",
        "type": "query",
        "datasource": { "type": "loki", "uid": "a301-loki" },
        "query": "label_values(service)",
        "definition": "label_values(service)",
        "refresh": 2,
        "sort": 1,
        "includeAll": true,
        "multi": true,
        "allValue": ".+",
        "current": { "text": ["All"], "value": ["$__all"] }
      },
      {
        "name": "search",
        "label": "검색어",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "오류 · 예외 줄 수 (서비스별)",
      "description": "error · exception · traceback이 들어간 줄 수. 언제부터 문제가 생겼는지 찾을 때 본다",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "a301-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (service) (count_over_time({env=\"prod\", service=~\"$service\"} |~ `(?i)(error|exception|traceback)` [$__interval]))",
          "legendFormat": "{{service}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 60, "lineWidth": 1, "stacking": { "mode": "normal" } },
          "unit": "short"
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "list", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 2,
      "type": "logs",
      "title": "로그",
      "description": "최근 로그가 위에 온다. 줄을 누르면 컨테이너 · 서비스 라벨을 볼 수 있다",
      "gridPos": { "h": 24, "w": 24, "x": 0, "y": 7 },
      "datasource": { "type": "loki", "uid": "a301-loki" },
      "targets": [
        {
          "refId": "A",
          "expr": "{env=\"prod\", service=~\"$service\"} |= `$search`",
          "queryType": "range",
          "maxLines": 1000
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    }
  ]
}
