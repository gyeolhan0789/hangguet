{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadEgressParameters",
      "Effect": "Allow",
      "Action": ["ssm:GetParameter", "ssm:GetParameters"],
      "Resource": "arn:aws:ssm:ap-northeast-2:*:parameter/a301/prod/egress/*"
    },
    {
      "Sid": "DecryptSecureStringParameters",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.ap-northeast-2.amazonaws.com" }
      }
    },
    {
      "Sid": "FindOwnAutoScalingGroup",
      "Effect": "Allow",
      "Action": "autoscaling:DescribeAutoScalingInstances",
      "Resource": "*"
    },
    {
      "Sid": "ManageOwnInstanceInEgressGroup",
      "Effect": "Allow",
      "Action": [
        "autoscaling:SetInstanceProtection",
        "autoscaling:SetInstanceHealth",
        "autoscaling:CompleteLifecycleAction"
      ],
      "Resource": "arn:aws:autoscaling:ap-northeast-2:*:autoScalingGroup:*:autoScalingGroupName/a301-prod-egress-node"
    }
  ]
}
