# 로컬 개발용 환경 변수 예시
# 이 파일을 .env로 복사해 사용한다. .env는 커밋하지 않는다.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=a301
POSTGRES_USER=a301
POSTGRES_PASSWORD=a301-local
# 로컬에 설치된 PostgreSQL(5432)과 겹치지 않도록 5433을 쓴다.
POSTGRES_PORT=5433

# Redis: REDIS_PORT는 Compose의 호스트 포트와 로컬 백엔드 접속 포트에 사용한다.
# 컨테이너 내부 포트는 6379로 유지한다.
REDIS_HOST=localhost
REDIS_PORT=6379

# BE 필수 값: 없으면 BE가 뜨지 않는다. 아래는 로컬 전용 예시이고 운영 값은 GitLab CI/CD Variables에 둔다.
# JWT 서명 키(32바이트 이상)
JWT_SECRET=local-only-signing-secret-at-least-32-bytes
# 문의 제목·본문 암호화 키(Base64, 32바이트). 새로 만들기: openssl rand -base64 32
INQUIRY_ENCRYPTION_KEY=bG9jYWwtb25seS1pbnF1aXJ5LWtleS0zMi1ieXRlcyE=

# 관리자 계정(선택): 셋 다 있으면 기동 때 관리자를 만든다
ADMIN_LOGIN_ID=
ADMIN_PASSWORD=
ADMIN_NAME=
