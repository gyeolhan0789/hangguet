# 로컬 개발용 환경 변수 예시
# 이 파일을 .env로 복사해 사용한다. .env는 커밋하지 않는다.

# PostgreSQL (docker-compose.yml)
POSTGRES_DB=a301
POSTGRES_USER=a301
POSTGRES_PASSWORD=a301-local
# 로컬에 설치된 PostgreSQL(5432)과 겹치지 않도록 5433을 쓴다.
POSTGRES_PORT=5433

# Redis: REDIS_PORT는 Compose의 호스트 포트와 로컬 백엔드 접속 포트에 사용한다.
# 컨테이너 내부 포트는 6379로 유지한다.
REDIS_HOST=localhost
REDIS_PORT=6379
